# Editors / OS
.idea/
# Personal editor state is ignored, but the run/debug/task configs below
# are project tooling (not per-person preference) and are meant to ship --
# they are what makes "clone and run" work inside VS Code. Applies at any
# depth: both .vscode/ at the repo root and ezr/.vscode/ for opening the
# ezr/ subtree on its own.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store

# Tapestry forge run logs (ledger.json and ratified.json are kept)
ezr/7-forge/forge-run.log
ezr/archive/notebook.db

# Tapestry build artifacts and run state (all regenerated by run.sh)
ezr/0-atom-c/tapestry_test
ezr/1-phase-cpp/phase_test
ezr/1-phase-cpp/*.o
ezr/4-archive-sql/tapestry.db
ezr/7-forge/cycles-run.log

# Built distributables
*.zip
