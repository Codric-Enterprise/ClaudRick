# ReVision local environment template.
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit real secrets. The session-start hook
# auto-loads `.env` when present (see .claude/hooks/session-start.sh), and you
# can source it into your own shell with `set -a; . ./.env; set +a`.

# --- Secrets -----------------------------------------------------------------

# Anthropic API key. Read only server-side; never shipped to the browser.
# Required to actually call Claude (the app starts without it and returns a
# graceful error).
ANTHROPIC_API_KEY=

# GitHub personal access token (or fine-grained token). Used for local GitHub
# API / git operations. Prefer the least scopes you need. In CI, use
# `${{ secrets.GITHUB_TOKEN }}` instead of a checked-in value.
GITHUB_TOKEN=

# --- Server config (all optional; defaults shown) ----------------------------

# Claude model id the server uses. See src/revision/config.py.
# REVISION_MODEL=claude-sonnet-5

# Bind host / port for the local server.
# REVISION_HOST=127.0.0.1
# REVISION_PORT=8000

# Optional bearer token required on /api/messages (auth disabled if unset).
# REVISION_API_TOKEN=

# Per-client rate limit for /api/messages (0 = off) and its window in seconds.
# REVISION_RATE_LIMIT=30
# REVISION_RATE_WINDOW=60

# Trust X-Forwarded-For for the client IP (enable only behind a reverse proxy).
# REVISION_TRUST_PROXY=false
