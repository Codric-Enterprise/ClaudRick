{
  "python.analysis.extraPaths": [
    "ezr/2-interpreter-python",
    "ezr/7-forge"
  ],
  "python.analysis.autoSearchPaths": true,
  "python.terminal.activateEnvironment": false,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.o": true
  },
  "files.associations": {
    "*.ebnf": "plaintext",
    "*.ezr": "plaintext",
    "*.ever": "plaintext"
  },
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
}
